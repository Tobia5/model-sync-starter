<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.modelsync</groupId>
    <artifactId>model-sync-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>
  <artifactId>model-sync-testkit</artifactId>
  <dependencies>
    <dependency>
      <groupId>io.modelsync</groupId>
      <artifactId>model-sync-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <properties><maven.deploy.skip>true</maven.deploy.skip><maven.install.skip>true</maven.install.skip></properties>
  <profiles><profile><id>full</id><build><plugins>
    <plugin>
      <groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId><version>1.25.9</version>
      <dependencies><dependency><groupId>org.pitest</groupId><artifactId>pitest-junit5-plugin</artifactId><version>1.2.3</version></dependency></dependencies>
      <executions><execution><id>behavioral-mutations</id><phase>verify</phase><goals><goal>mutationCoverage</goal></goals></execution></executions>
      <configuration>
        <crossModule>true</crossModule><threads>2</threads><timestampedReports>false</timestampedReports>
        <failWhenNoMutations>true</failWhenNoMutations><mutationThreshold>85</mutationThreshold><thresholdPrecision>2</thresholdPrecision>
        <outputFormats><param>XML</param><param>HTML</param></outputFormats>
        <targetClasses>
          <param>io.modelsync.core.domain.FreshnessPolicy</param>
          <param>io.modelsync.core.application.SyncAccess</param>
          <param>io.modelsync.core.application.SyncCoordinator</param>
          <param>io.modelsync.core.application.SyncPlanner</param>
          <param>io.modelsync.core.application.SyncResultApplier</param>
          <param>io.modelsync.core.application.SyncFailurePolicy</param>
          <param>io.modelsync.core.application.SyncJob</param>
        </targetClasses>
        <targetTests><param>io.modelsync.testkit.CoreContractsTest</param><param>io.modelsync.testkit.TriggerContractsTest</param></targetTests>
      </configuration>
    </plugin>
  </plugins></build></profile></profiles>
</project>
